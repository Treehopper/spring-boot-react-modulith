<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>modulith-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>modulith-parent</name>
    <description>Spring Boot + React modulith template</description>

    <modules>
        <!-- Order matters: the backend embeds the frontend jar. -->
        <module>frontend</module>
        <module>backend</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <archunit.version>1.5.1</archunit.version>
        <openapi-generator.version>7.26.0</openapi-generator.version>
        <springdoc.version>3.1.1</springdoc.version>
        <frontend-maven-plugin.version>2.0.2</frontend-maven-plugin.version>
        <node.version>v24.21.0</node.version>
    </properties>
</project>
